<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      把本文件放进 Payload/Instagram.app/（和 Instagram 可执行文件同级）。

      按钮内容优先级：远程控制端(ControlURL) > 本地 Buttons > 内置三条
      内置三条 = 店铺中心 / 商品橱窗 / 订单详情（16 种语言，跟随系统语言）

      本地 Buttons 每个元素：Title 文案、URL 链接、Icon SF Symbols 名（可省）
    -->

    <!-- ★ 控制端地址：返回 {"buttons":[{"id","url","title":{语言:文案},"icon"}]}
         留空 = 不请求远程，只用本地/内置；必须是 https（App Transport Security） -->
    <key>ControlURL</key>
    <string></string>

    <!-- 可选：本地覆盖（不放这段就用内置的三条多语言按钮） -->
    <key>Buttons</key>
    <array>
    </array>

    <!-- above：放在「编辑主页」这一行上面（默认，避免被 IG 自己的按钮盖住）
         below：放在下面 -->
    <key>Position</key>
    <string>above</string>

    <!-- true：用系统 SFSafariViewController（最稳）；false：用自绘 WKWebView -->
    <key>UseSafariViewController</key>
    <true/>

    <!-- 排障：true = 不插 header，直接悬浮在安全区顶部，保证能看见 -->
    <key>ForceDock</key>
    <false/>

    <!-- 按钮行尺寸（pt）：贴按钮上方时的行高 / 与按钮行的间距 -->
    <key>RowHeight</key>
    <real>36</real>
    <key>OverlayHeight</key>
    <real>28</real>
    <key>OverlayGap</key>
    <real>4</real>

    <!-- true：先尝试把行插进 IG 的 header 布局（可能被裁掉）；默认 false，用跟随重叠层 -->
    <key>TryHeaderInsert</key>
    <false/>

    <!-- true：布局级插入（把 action bar cell 撑高，行真正长在页面里）；失败会自动退回跟随层 -->
    <key>NativeInsert</key>
    <true/>

    <!-- 启动 2 秒后弹一个「ProfileButtons 已加载」提示，确认 dylib 真的被加载 -->
    <key>ShowLaunchToast</key>
    <false/>

    <!-- 首次适配时打开，日志里会打印按钮祖先链，方便改插入位置 -->
    <key>Debug</key>
    <true/>
</dict>
</plist>
